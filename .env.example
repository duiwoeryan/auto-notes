# auto-notes 环境变量配置
# 复制此文件为 .env 并填写真实值
# 优先级：CLI 参数 > TOML 配置文件 > 环境变量 > 代码默认值

# ── LLM API ────────────────────────────
# OpenAI 兼容 API（DeepSeek / OpenAI / 其他）
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── 下载 ───────────────────────────────
# 浏览器 Cookie（chrome / firefox / safari / 空字符串禁用）
# AUTO_NOTES_COOKIES=chrome
# 下载代理
# AUTO_NOTES_PROXY=http://127.0.0.1:7890

# ── ASR 语音识别 ───────────────────────
# 音频语言：zh / en / auto
# AUTO_NOTES_LANG=zh

# ── LLM 默认参数 ───────────────────────
# 后端：openai / ollama
# AUTO_NOTES_LLM_PROVIDER=openai
# 模型名
# AUTO_NOTES_LLM_MODEL=deepseek-chat

# ── 模式 ───────────────────────────────
# true=仅音频，false=视频+OCR
# AUTO_NOTES_AUDIO_ONLY=true

# ── 目录 ───────────────────────────────
# AUTO_NOTES_OUTPUT_DIR=notes
# AUTO_NOTES_WORKING_DIR=workspace

# ── 其他 ───────────────────────────────
# 保留中间文件（1/true=保留，0/false=用完即删）
# AUTO_NOTES_KEEP=true
# 完整模式最大关键帧数
# AUTO_NOTES_MAX_KEYFRAMES=120
